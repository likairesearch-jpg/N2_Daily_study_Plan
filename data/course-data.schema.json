{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "N2 weekly course data v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentVersion",
    "id",
    "week",
    "dateRange",
    "dayRange",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "contentVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^week[0-9]{2,}$"
    },
    "week": {
      "type": "integer",
      "minimum": 1
    },
    "dateRange": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "dayRange": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/day"
      }
    }
  },
  "$defs": {
    "ja": {
      "type": "object",
      "required": [
        "display",
        "tts",
        "lang",
        "translationZh"
      ],
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1
        },
        "tts": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^（）]*$"
        },
        "lang": {
          "const": "ja-JP"
        },
        "translationZh": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "prompt",
        "explanationZh"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "single_choice",
            "open"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/ja"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "$ref": "#/$defs/ja"
              }
            }
          }
        },
        "answer": {
          "type": "string"
        },
        "sampleAnswer": {
          "$ref": "#/$defs/ja"
        },
        "explanationZh": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single_choice"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "answer"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "open"
              }
            }
          },
          "then": {
            "required": [
              "sampleAnswer"
            ]
          }
        }
      ]
    },
    "day": {
      "type": "object",
      "required": [
        "id",
        "week",
        "day",
        "date",
        "title",
        "source",
        "review",
        "vocabulary",
        "grammar",
        "reading",
        "listening",
        "speaking",
        "recap",
        "modules",
        "counts",
        "legacy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^day[0-9]{3,}$"
        },
        "week": {
          "type": "integer",
          "minimum": 1
        },
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "existing_formal",
                "new_authorized_continuation"
              ]
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "intervals"
          ],
          "properties": {
            "intervals": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "offsetDays",
                  "sourceDay",
                  "sourceDayId",
                  "vocabularyIds",
                  "grammarIds"
                ],
                "properties": {
                  "offsetDays": {
                    "enum": [
                      1,
                      3,
                      7
                    ]
                  },
                  "sourceDay": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "conceptId",
              "mode",
              "word",
              "reading",
              "firstTaughtDay",
              "collocations"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "new",
                  "review"
                ]
              },
              "word": {
                "$ref": "#/$defs/ja"
              }
            }
          }
        },
        "grammar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "conceptId",
              "mode",
              "form",
              "meaningZh",
              "examples"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "new",
                  "review"
                ]
              },
              "form": {
                "$ref": "#/$defs/ja"
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/ja"
                }
              }
            }
          }
        },
        "reading": {
          "type": "object",
          "required": [
            "text",
            "timeLimitSeconds",
            "firstPass",
            "questions"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/ja"
            },
            "questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/question"
              }
            }
          }
        },
        "listening": {
          "type": "object",
          "required": [
            "tts",
            "segments",
            "firstPass",
            "question"
          ],
          "properties": {
            "question": {
              "$ref": "#/$defs/question"
            }
          }
        }
      }
    }
  }
}